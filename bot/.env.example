# Токен Telegram-бота от @BotFather.
# Скопируйте этот файл в bot/.env и подставьте реальный токен.
BOT_TOKEN=

# Обязательный список Telegram user ID, которым разрешён доступ к личным данным.
# Несколько ID перечисляются через запятую. При пустом списке бот не запустится.
BOT_ALLOWED_IDS=123456789

# (Опционально) Прокси для Telegram через локальный SOCKS5 (например, Happ/xray).
# Можно указать НЕСКОЛЬКО через запятую — предпочтительный первым. Бот выберет
# первый отвечающий; если сейчас не отвечает ни один — будет ждать восстановления
# прокси (напрямую НЕ ходит, т.к. на этом ПК Telegram доступен только через прокси).
# TELEGRAM_PROXY=socks5://192.168.0.8:10820,socks5://192.168.0.8:10808
