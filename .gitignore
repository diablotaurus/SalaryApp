# Виртуальное окружение
.venv/
venv/
env/

# Байт-код
__pycache__/
*.py[cod]

# Базы данных
db/
db/backup/
*.db
*.sqlite3

# Резервные копии
*.bak
*.backup

# Логи
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# Системные файлы
.DS_Store
Thumbs.db

# PyInstaller
build/
dist/
*.spec

# Временные файлы
temp/
tmp/

# Файлы запуска (могут быть созданы пользователем)
*.lnk

# Секреты бота
bot/.env

# Экспортированные данные (содержат реальные суммы — не публиковать)
exports/

# Локальный путь к production для скрипта деплоя (личный путь, не публиковать)
scripts/deploy_target.local.txt

# Личный ярлык запуска web (содержит локальный путь)
Salary Web App.url
